@{
    ViewBag.Title = "Agregar Actividad";
    Layout = "~/Views/Shared/_LayoutSimple.cshtml";

    // Variables de estado
    bool proyectoFijo = ViewBag.ProyectoFijo ?? (ViewBag.IdProyecto != null);
    bool flujoSecuencial = ViewBag.FlujoSecuencial ?? false;

    var proyectosCombobox = ViewBag.ProyectosMapeados as List<ProyectoSemillero_ASP.NET.Models.DatosProyecto>;
}

<style>
    body > .container {
        display: block !important;
        padding-top: 2rem !important;
    }
</style>

<div class="w-100 text-start mb-5" style="max-width: 700px; margin: 0 auto;">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h3 class="fw-bold text-dark mb-0">
            <i class="bi bi-plus-circle-fill text-success me-2"></i> Registrar Nueva Actividad
        </h3>

        @if (!flujoSecuencial)
        {
            if (proyectoFijo)
            {
                <a href="@Url.Action("PorProyecto", "Actividades", new { idProyecto = ViewBag.IdProyecto })" class="btn btn-outline-secondary fw-bold shadow-sm">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
            }
            else
            {
                <a href="@Url.Action("Index", "Actividades")" class="btn btn-outline-secondary fw-bold shadow-sm">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </a>
            }
        }
    </div>

    @if (flujoSecuencial)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 border-start border-5 border-success mb-4" role="alert">
            <h5 class="alert-heading fw-bold text-success mb-2">
                <i class="bi bi-check-circle-fill me-2"></i> @Html.Raw(ViewBag.MensajeExitoProyecto ?? "¡Proyecto creado con éxito!")
            </h5>
            <hr class="border-success opacity-25 my-2">
            <p class="mb-0 text-dark">
                <i class="bi bi-info-circle-fill text-primary me-1"></i> @Html.Raw(ViewBag.MensajeInstruccion ?? "Para continuar con el proceso, es obligatorio registrar la primera actividad de este proyecto.")
            </p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 bg-white">
        <div class="card-body p-4">
            <form action="@Url.Action("Agregar", "Actividades")" method="post" id="formAgregarActividad">

                <input type="hidden" name="vinoDesdeProyecto" value="@(proyectoFijo ? "true" : "false")" />
                <input type="hidden" name="flujoSecuencial" value="@(flujoSecuencial ? "true" : "false")" />

                <div class="row">
                    <div class="col-12 col-md-8 mb-4">
                        <label class="form-label fw-bold text-secondary"><i class="bi bi-folder-fill me-1"></i> Proyecto Asociado</label>

                        @if (proyectoFijo)
                        {
                            <input type="hidden" name="idProyecto" value="@ViewBag.IdProyecto" />
                            <div class="input-group">
                                <span class="input-group-text bg-light text-dark fw-bold">ID: @ViewBag.IdProyecto</span>
                                <input type="text" class="form-control bg-light text-muted fw-semibold border-secondary-subtle" value="@ViewBag.TituloProyecto" readonly disabled />
                            </div>
                        }
                        else
                        {
                            <select class="form-select border-info fw-medium" name="idProyecto" id="selectProyectoForm" required>
                                <option value="" data-inicio="" data-fin="">-- Seleccione el proyecto de destino --</option>
                                @if (proyectosCombobox != null)
                                {
                                    foreach (var proj in proyectosCombobox)
                                    {
                                        <option value="@proj.IdProyecto" data-inicio="@proj.FechaInicioProyecto" data-fin="@proj.FechaFinProyecto">ID: @proj.IdProyecto - @proj.TituloProyecto</option>
                                    }
                                }
                            </select>
                        }
                    </div>

                    <div class="col-12 col-md-4 mb-4">
                        <label class="form-label fw-bold text-secondary"><i class="bi bi-hash me-1"></i> ID Actividad</label>
                        <input type="text" class="form-control bg-light text-muted fw-bold border-secondary-subtle" value="Cód: @(ViewBag.SiguienteId ?? "40X")" readonly disabled title="Este ID se genera automáticamente" />
                    </div>
                </div>

                <hr class="text-muted my-3" />

                <div class="mb-3">
                    <label for="nombreActividad" class="form-label fw-bold text-secondary"><i class="bi bi-bookmark-plus-fill me-1"></i> Nombre de la Actividad</label>
                    <input type="text" class="form-control border-secondary-subtle" id="nombreActividad" name="nombreActividad" placeholder="Ej. Diseño de la Base de Datos" maxlength="150" required autocomplete="off" />
                </div>

                <div class="row mt-3">
                    <div class="col-12 col-md-4 mb-3">
                        <label for="estadoActividad" class="form-label fw-bold text-secondary"><i class="bi bi-activity me-1"></i> Estado Inicial</label>
                        <select class="form-select border-secondary-subtle fw-semibold" id="estadoActividad" name="estadoActividad" required>
                            <option value="Pendiente" selected>Pendiente</option>
                            <option value="En Progreso">En Progreso</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-8 mb-3">
                        <label class="form-label fw-bold text-secondary"><i class="bi bi-people-fill me-1"></i> Asignar Investigadores (Máx 2)</label>
                        <div class="card border-secondary-subtle shadow-sm p-3 bg-light" style="max-height: 140px; overflow-y: auto;" id="contenedorCheckboxes">

                            @{
                                string rolActual = Session["Rol"] != null ? Session["Rol"].ToString() : "";
                                bool esLider = rolActual == "Lider" || rolActual == "Líder";
                                bool mostrarDeInmediato = proyectoFijo || esLider;
                            }

                            @if (mostrarDeInmediato)
                            {
                                if (ViewBag.Investigadores != null && ViewBag.Investigadores.Count > 0)
                                {
                                    foreach (var inv in ViewBag.Investigadores)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input chk-investigador border-secondary" type="checkbox" name="investigadoresResponsables" value="@inv.IdUsuario" id="chk_@inv.IdUsuario">
                                            <label class="form-check-label text-dark fw-medium" for="chk_@inv.IdUsuario">
                                                @inv.NombreUsuario
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">El semillero de este proyecto no tiene investigadores registrados.</span>
                                }
                            }
                            else
                            {
                                <div class="text-center text-muted small mt-3" id="mensajeEsperaCheck">
                                    <i class="bi bi-arrow-up-circle fs-4 d-block mb-1"></i>
                                    Seleccione un proyecto para cargar los investigadores disponibles.
                                </div>
                            }

                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-4 mb-3">
                        <label for="fechaInicioActividad" class="form-label fw-bold text-secondary"><i class="bi bi-calendar-play-fill me-1"></i> Fecha de Inicio</label>
                        <input type="date" class="form-control border-secondary-subtle" id="fechaInicioActividad" name="fechaInicioActividad" required />
                    </div>

                    <div class="col-12 col-md-4 mb-3">
                        <label for="duracionValor" class="form-label fw-bold text-secondary"><i class="bi bi-stopwatch-fill me-1"></i> Duración Estimada</label>
                        <div class="input-group">
                            <input type="number" class="form-control border-secondary-subtle" id="duracionValor" name="duracionValor" min="1" placeholder="Cant." required />
                            <select class="form-select border-secondary-subtle fw-semibold" id="duracionUnidad" name="duracionUnidad" required>
                                <option value="Días">Días</option>
                                <option value="Semanas">Semanas</option>
                                <option value="Meses">Meses</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-12 col-md-4 mb-3">
                        <label for="fechaEntregaActividad" class="form-label fw-bold text-secondary"><i class="bi bi-calendar-check-fill me-1"></i> Fecha de Entrega</label>
                        <input type="date" class="form-control border-secondary-subtle" id="fechaEntregaActividad" name="fechaEntregaActividad" required />
                        <small class="text-muted" id="ayudaFecha"><i class="bi bi-info-circle"></i> Se calculará automáticamente.</small>
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-success fw-bold px-4 shadow-sm" id="btnGuardarActividad">
                        @if (flujoSecuencial)
                        {
                            <i class="bi bi-arrow-right-circle me-1"></i> @:Siguiente: Agregar Fases
                        }
                        else
                        {
                            <i class="bi bi-check-circle me-1"></i> @:Guardar Actividad
                        }
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- LÓGICA EXCLUSIVA DEL FLUJO SECUENCIAL ---
        @if (flujoSecuencial)
        {
            <text>
            document.addEventListener("DOMContentLoaded", function() {
                window.history.pushState(null, "", window.location.href);
                window.onpopstate = function() {
                    window.history.pushState(null, "", window.location.href);
                };
            });
            </text>
        }

        // --- DECLARACIÓN DE VARIABLES GLOBALES ---
        const txtInicio = document.getElementById('fechaInicioActividad');
        const txtValor = document.getElementById('duracionValor');
        const cboUnidad = document.getElementById('duracionUnidad');
        const txtFecha = document.getElementById('fechaEntregaActividad');
        const ayudaFecha = document.getElementById('ayudaFecha');

        const selectProyecto = document.getElementById('selectProyectoForm');
        const contenedorCheckboxes = document.getElementById('contenedorCheckboxes');
        const urlObtenerInvestigadores = '@Url.Action("ObtenerInvestigadoresPorProyecto", "Actividades")';

        // --- INICIALIZAR FECHA MÍNIMA (HOY) ---
        function establecerMinimoAbsoluto() {
            if (!txtInicio) return;
            let hoy = new Date();
            const yyyy = hoy.getFullYear();
            const mm = String(hoy.getMonth() + 1).padStart(2, '0');
            const dd = String(hoy.getDate()).padStart(2, '0');
            txtInicio.min = `${yyyy}-${mm}-${dd}`;

            // Si no tiene valor, sugerir la fecha de hoy
            if(!txtInicio.value) txtInicio.value = `${yyyy}-${mm}-${dd}`;
        }

        // --- LÓGICA DE CÁLCULO DE FECHAS ---
        function calcularFechaProyectada() {
            if (!txtValor || !cboUnidad || !txtFecha || !txtInicio || !txtInicio.value) return;

            const valor = parseInt(txtValor.value) || 0;
            const unidad = cboUnidad.value;

            if (valor <= 0) return;

            // El cálculo arranca desde la fecha de inicio seleccionada
            let fechaCalculada = new Date(txtInicio.value + 'T00:00:00');

            if (unidad === 'Días') {
                fechaCalculada.setDate(fechaCalculada.getDate() + valor);
            } else if (unidad === 'Semanas') {
                fechaCalculada.setDate(fechaCalculada.getDate() + (valor * 7));
            } else if (unidad === 'Meses') {
                fechaCalculada.setMonth(fechaCalculada.getMonth() + valor);
            }

            const yyyy = fechaCalculada.getFullYear();
            const mm = String(fechaCalculada.getMonth() + 1).padStart(2, '0');
            const dd = String(fechaCalculada.getDate()).padStart(2, '0');

            txtFecha.value = `${yyyy}-${mm}-${dd}`;
            txtFecha.min = txtInicio.value;
            if (ayudaFecha) ayudaFecha.innerHTML = `<i class="bi bi-lock-fill text-success"></i> Entrega calculada según duración.`;
        }

        // --- VALIDACIÓN ESTRICTA CONTRA LÍMITES DEL PROYECTO ---
        function validarLimitesFecha() {
            if (!txtInicio || !txtInicio.value || !txtFecha || !txtFecha.value) return;

            let limiteInicio = '@(ViewBag.FechaInicioProyecto ?? "")';
            let limiteFin = '@(ViewBag.FechaFinProyecto ?? "")';

            if (selectProyecto && selectProyecto.value) {
                const opt = selectProyecto.options[selectProyecto.selectedIndex];
                limiteInicio = opt.getAttribute('data-inicio') || '';
                limiteFin = opt.getAttribute('data-fin') || '';
            }

            if (!limiteInicio || !limiteFin) return;

            const vInicio = new Date(txtInicio.value + 'T00:00:00');
            const vEntrega = new Date(txtFecha.value + 'T00:00:00');
            const max = new Date(limiteFin + 'T00:00:00');
            const min = new Date(limiteInicio + 'T00:00:00');

            // 1. Validar que el inicio no se salga del proyecto
            if (vInicio < min || vInicio > max) {
                Swal.fire({ icon: 'warning', title: 'Fecha de Inicio Inválida', text: `La actividad debe iniciar dentro de las fechas del proyecto (${limiteInicio} al ${limiteFin}).`, confirmButtonColor: '#ffc107' });
                txtInicio.value = limiteInicio;
                // Si el inicio se corrige, debemos recalcular la entrega obligatoriamente
                originalCalcularFecha();
            }

            // 2. Validar que la entrega recalculada no supere el fin del proyecto
            const vEntregaNueva = new Date(txtFecha.value + 'T00:00:00');
            if (vEntregaNueva > max) {
                Swal.fire({ icon: 'warning', title: 'Límite de Entrega Excedido', text: `La duración hace que la entrega supere la fecha final del proyecto (${limiteFin}). Se ajustará al límite máximo permitido.`, confirmButtonColor: '#ffc107' });
                txtFecha.value = limiteFin;
                if (ayudaFecha) ayudaFecha.innerHTML = `<i class="bi bi-exclamation-triangle-fill text-warning"></i> Entrega ajustada al límite del proyecto.`;
            }
        }

        // Enlazamos las validaciones en cadena
        const originalCalcularFecha = calcularFechaProyectada;
        calcularFechaProyectada = function() {
            originalCalcularFecha();
            validarLimitesFecha();
        };

        if (txtInicio) txtInicio.addEventListener('change', calcularFechaProyectada);
        if (txtValor) txtValor.addEventListener('input', calcularFechaProyectada);
        if (cboUnidad) cboUnidad.addEventListener('change', calcularFechaProyectada);
        if (txtFecha) txtFecha.addEventListener('change', validarLimitesFecha);

        document.addEventListener('DOMContentLoaded', establecerMinimoAbsoluto);

        // --- RESTO DE TU JS (GUARDADO Y AJAX) SE MANTIENE INTACTO ---
        const formActividad = document.getElementById('formAgregarActividad');
        if (formActividad) {
            formActividad.addEventListener('submit', function () {
                const btn = document.getElementById('btnGuardarActividad');
                if (btn) {
                    setTimeout(function () {
                        btn.disabled = true;
                        btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Guardando...`;
                    }, 50);
                }
            });
        }

        if (selectProyecto && contenedorCheckboxes) {
            selectProyecto.addEventListener('change', function () {
                const idProyectoSeleccionado = this.value;
                if(txtValor.value) calcularFechaProyectada();

                if (!idProyectoSeleccionado) {
                    contenedorCheckboxes.innerHTML = `<div class="text-center text-muted small mt-3"><i class="bi bi-arrow-up-circle fs-4 d-block mb-1"></i> Seleccione un proyecto para cargar los investigadores disponibles.</div>`;
                    return;
                }

                contenedorCheckboxes.innerHTML = '<div class="text-center text-primary mt-3"><div class="spinner-border spinner-border-sm" role="status"></div> Cargando equipo...</div>';

                fetch(`${urlObtenerInvestigadores}?idProyecto=${idProyectoSeleccionado}`)
                    .then(response => response.json())
                    .then(resultado => {
                        if (resultado.exito) {
                            if (resultado.data.length > 0) {
                                let htmlCheckboxes = '';
                                resultado.data.forEach(inv => {
                                    htmlCheckboxes += `
                                        <div class="form-check mb-2">
                                            <input class="form-check-input chk-investigador border-secondary" type="checkbox" name="investigadoresResponsables" value="${inv.IdUsuario}" id="chk_${inv.IdUsuario}">
                                            <label class="form-check-label text-dark fw-medium" for="chk_${inv.IdUsuario}">${inv.NombreUsuario}</label>
                                        </div>
                                    `;
                                });
                                contenedorCheckboxes.innerHTML = htmlCheckboxes;
                            } else {
                                contenedorCheckboxes.innerHTML = '<span class="text-muted small fst-italic">El semillero de este proyecto no tiene investigadores registrados.</span>';
                            }
                        } else {
                            Swal.fire({ icon: 'error', title: 'Error', text: resultado.mensaje });
                            contenedorCheckboxes.innerHTML = '<span class="text-danger small"><i class="bi bi-x-circle"></i> Error al cargar datos.</span>';
                        }
                    })
                    .catch(error => {
                        contenedorCheckboxes.innerHTML = '<span class="text-danger small">Error de conexión con el servidor.</span>';
                    });
            });
        }

        if (contenedorCheckboxes) {
            contenedorCheckboxes.addEventListener('change', function (e) {
                if (e.target && e.target.classList.contains('chk-investigador')) {
                    const checkeados = document.querySelectorAll('.chk-investigador:checked');
                    if (checkeados.length > 2) {
                        e.target.checked = false;
                        Swal.fire({ icon: 'warning', title: 'Límite alcanzado', text: 'Solo puedes asignar un máximo de 2 investigadores a esta actividad.', confirmButtonColor: '#ffc107' });
                    }
                }
            });
        }
        function calcularEstadoAutomatico() {
            if (!txtInicio || !txtInicio.value || !txtFecha || !txtFecha.value) return;

            const hoy = new Date();
            hoy.setHours(0, 0, 0, 0);

            const vInicio = new Date(txtInicio.value + 'T00:00:00');
            const vEntrega = new Date(txtFecha.value + 'T00:00:00');
            const inputEstado = document.getElementById('estadoActividad');

            if (inputEstado) {
                // Respetamos si el backend ya mandó que está Finalizado
                if (inputEstado.value === "Finalizado") {
                    inputEstado.className = "form-control bg-light fw-bold text-success border-success-subtle";
                    return;
                }

                // CAMBIO A RETRASADO
                if (hoy > vEntrega) {
                    inputEstado.value = "Retrasado";
                    inputEstado.className = "form-control bg-light fw-bold text-danger border-danger-subtle";
                } else if (hoy >= vInicio && hoy <= vEntrega) {
                    inputEstado.value = "En Progreso";
                    inputEstado.className = "form-control bg-light fw-bold text-primary border-primary-subtle";
                } else {
                    inputEstado.value = "Pendiente";
                    inputEstado.className = "form-control bg-light fw-bold text-warning border-warning-subtle";
                }
            }
        }
    </script>
}