@{
    ViewBag.Title = "Panel General de Gestión y Reportes";
}

<div class="container mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="mb-0">Gestión de Módulos y Reportes</h2>
            <p class="text-muted">Seleccione un módulo para administrarlo o previsualizar su reporte en formato PDF.</p>
        </div>
    </div>
    <hr />

    <div class="row">
        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center d-flex flex-column">
                    <h4 class="card-title">Usuarios</h4>
                    <p class="card-text text-muted flex-grow-1">Gestión de investigadores y roles.</p>
                    <div class="d-grid gap-2 mt-3">
                        <a href="@Url.Action("Index", "Usuarios")" class="btn btn-outline-primary">Ir a Gestionar</a>
                        <a href="@Url.Action("Descargar", "Reportes", new { modulo = "usuarios" })" target="_blank" class="btn btn-success">Previsualizar Reporte</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center d-flex flex-column">
                    <h4 class="card-title">Semillero</h4>
                    <p class="card-text text-muted flex-grow-1">Administración del semillero.</p>
                    <div class="d-grid gap-2 mt-3">
                        <a href="@Url.Action("Index", "Semilleros")" class="btn btn-outline-primary">Ir a Gestionar</a>
                        <a href="@Url.Action("Descargar", "Reportes", new { modulo = "semillero" })" target="_blank" class="btn btn-success">Previsualizar Reporte</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center d-flex flex-column">
                    <h4 class="card-title">Proyectos</h4>
                    <p class="card-text text-muted flex-grow-1">Registro de proyectos.</p>
                    <div class="d-grid gap-2 mt-3">
                        <a href="@Url.Action("Index", "Proyectos")" class="btn btn-outline-primary">Ir a Gestionar</a>
                        <a href="@Url.Action("Descargar", "Reportes", new { modulo = "proyecto" })" target="_blank" class="btn btn-success">Previsualizar Reporte</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center d-flex flex-column">
                    <h4 class="card-title">Actividades</h4>
                    <p class="card-text text-muted flex-grow-1">Control de tareas.</p>
                    <div class="d-grid gap-2 mt-3">
                        <a href="@Url.Action("Index", "Actividades")" class="btn btn-outline-primary">Ir a Gestionar</a>
                        <a href="@Url.Action("Descargar", "Reportes", new { modulo = "actividades" })" target="_blank" class="btn btn-success">Previsualizar Reporte</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center d-flex flex-column">
                    <h4 class="card-title">Fases</h4>
                    <p class="card-text text-muted flex-grow-1">Estructura y etapas.</p>
                    <div class="d-grid gap-2 mt-3">
                        <a href="@Url.Action("Index", "Fases")" class="btn btn-outline-primary">Ir a Gestionar</a>
                        <a href="@Url.Action("Descargar", "Reportes", new { modulo = "fases" })" target="_blank" class="btn btn-success">Previsualizar Reporte</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center d-flex flex-column">
                    <h4 class="card-title">Reuniones</h4>
                    <p class="card-text text-muted flex-grow-1">Actas y programación.</p>
                    <div class="d-grid gap-2 mt-3">
                        <a href="@Url.Action("Index", "Reuniones")" class="btn btn-outline-primary">Ir a Gestionar</a>
                        <a href="@Url.Action("Descargar", "Reportes", new { modulo = "reuniones" })" target="_blank" class="btn btn-success">Previsualizar Reporte</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center d-flex flex-column">
                    <h4 class="card-title">Eventos</h4>
                    <p class="card-text text-muted flex-grow-1">Asistencia a eventos.</p>
                    <div class="d-grid gap-2 mt-3">
                        <a href="@Url.Action("Index", "Eventos")" class="btn btn-outline-primary">Ir a Gestionar</a>
                        <a href="@Url.Action("Descargar", "Reportes", new { modulo = "eventos" })" target="_blank" class="btn btn-success">Previsualizar Reporte</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center d-flex flex-column">
                    <h4 class="card-title">Patrocinadores</h4>
                    <p class="card-text text-muted flex-grow-1">Apoyo al semillero.</p>
                    <div class="d-grid gap-2 mt-3">
                        <a href="@Url.Action("Index", "Patrocinadores")" class="btn btn-outline-primary">Ir a Gestionar</a>
                        <a href="@Url.Action("Descargar", "Reportes", new { modulo = "patrocinadores" })" target="_blank" class="btn btn-success">Previsualizar Reporte</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>