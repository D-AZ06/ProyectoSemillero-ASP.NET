@{
    // Rescatamos los datos de la sesión
    string nombreUsuario = Session["UsuarioLogueado"] as string ?? "Usuario";
    string rolUsuario = Session["Rol"] as string ?? "Sin Rol";

    // Capturamos el nombre exacto de la Acción (vista) en la que estamos navegando
    string accionActual = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GesSi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"> <!-- Bootstrap CSS  -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"> <!-- Bootstrap Icons -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script> <!-- jQuery, necesario para $.get en las vistas -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> <!-- SweetAlert2 para alertas y mensajes -->


    <style>
        :root {
            --bg-body: #f4f7f6;
            --blue-primary: #0284c7;
            --navbar-height: 75px;
        }

        body {
            background-color: var(--bg-body);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            margin: 0;
            padding-top: var(--navbar-height);
        }

        /* --- BARRA SUPERIOR FIJA --- */
        .top-navbar-login {
            height: var(--navbar-height);
            background-color: rgba(255, 255, 255, 0.98);
            border-bottom: 1px solid rgba(0,0,0,0.08);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1050;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 1.5rem;
        }

        /* Logo Icono Superior (Plano) */
        .logo-icon {
            background-color: var(--blue-primary);
            color: white;
            width: 38px;
            height: 38px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>

    <header class="top-navbar-login">
        @if (accionActual != "Bienvenida" && accionActual != "IniciarSesion")
        {
            <div class="d-flex align-items-center" style="flex: 1;">
                <div class="d-flex flex-column lh-sm">
                    <span class="fw-bold text-dark" style="font-size: 0.95rem;">@nombreUsuario</span>
                    <span class="text-secondary mt-1 d-flex align-items-center gap-1" style="font-size: 0.75rem;">
                        <i class="bi bi-person-badge-fill text-primary"></i> @rolUsuario
                    </span>
                </div>
            </div>
        }
        else
        {
            <div style="flex: 1;"></div>
        }

        <div class="d-flex justify-content-center align-items-center" style="flex: 1;">
            <div class="d-flex align-items-center gap-2">
                <div class="logo-icon">
                    <i class="bi bi-cpu fs-5"></i>
                </div>
                <span class="fs-4 fw-bold text-dark m-0 tracking-tight" style="letter-spacing: -0.5px;">GesSi</span>
            </div>
        </div>

        <div style="flex: 1;"></div>
    </header>

    <div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: calc(100vh - var(--navbar-height));">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>